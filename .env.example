# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres
DATABASE_URL=

# Neon AI Gateway (Claude): use ${NEON_AI_GATEWAY_BASE_URL}/anthropic
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Public auth URL, safe for the browser (VITE_ prefix = exposed to client)
VITE_NEON_AUTH_URL=

# Whoop
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Spoonacular
SPOONACULAR_API_KEY=
# Set to 1 to serve src/recipes/fixtures instead of calling Spoonacular (saves quota)
FAKE_SPOONACULAR=

# Exa
EXA_API_KEY=
