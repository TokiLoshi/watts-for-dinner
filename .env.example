# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres
DATABASE_URL=

# Neon AI Gateway (Claude): use ${NEON_AI_GATEWAY_BASE_URL}/anthropic
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# Better Auth (Google sign-in). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# App origin, e.g. http://localhost:3100 (Fly: https://watts-for-dinner.fly.dev)
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Whoop
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Spoonacular
SPOONACULAR_API_KEY=
# Set to 1 to serve src/recipes/fixtures instead of calling Spoonacular (saves quota)
FAKE_SPOONACULAR=

# Exa
EXA_API_KEY=
